# Environment Variables for Custom Domain Email Service

# GEMINI_API_KEY: Optional - AI Smart Reply, Email Summary, and Draft Assistant
GEMINI_API_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Security / JWT Secret
JWT_SECRET=super-secret-jwt-key-replace-in-production-random-bytes

# Database Configuration (PostgreSQL for Render / VPS, SQLite fallback for local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webmail_db
DB_TYPE=sqlite

# Storage Configuration (local or s3)
STORAGE_TYPE=local
STORAGE_DIR=./uploads
# S3 Configuration (Optional for AWS S3 / Cloudflare R2 / Render Disk)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# Outbound Default SMTP Relay (Optional fallback if direct port 25 is restricted by host)
# SMTP_DEFAULT_HOST=smtp.sendgrid.net
# SMTP_DEFAULT_PORT=587
# SMTP_DEFAULT_USER=apikey
# SMTP_DEFAULT_PASS=
# SMTP_DEFAULT_SECURE=false

# Spam Filtering & Limits
MAX_ATTACHMENT_SIZE_MB=25
MAX_EMAILS_PER_HOUR=100
ENABLE_SPAM_FILTER=true
